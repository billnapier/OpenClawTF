#!/usr/bin/env python3
"""
OpenClaw Unified CLI Tool (`openclaw`).
Provides top-level command line interface for OpenClaw operations:
  openclaw chat ["<message>"]
  openclaw channels status [--probe]
  openclaw gateway status [--deep]
  openclaw models list
  openclaw doctor
  openclaw whitelist [list|add|remove]
"""

import sys
import os
import json
import argparse
import subprocess
import urllib.request
import getpass

# Fixed session id for the single continuing CLI conversation thread per host
# (FR-002/FR-007 — "one continuing thread per host", not per OS user).
CLI_SESSION_ID = "cli"

# Input size limit for `openclaw chat` messages (FR-010).
CHAT_MAX_LENGTH = 8000


def validate_chat_input(text):
    """Validate a chat message before any network call (FR-010).

    Rejects: invalid UTF-8, NUL/binary control bytes, and messages longer
    than CHAT_MAX_LENGTH characters. Returns (True, None) if valid, or
    (False, "<reason>") if not.
    """
    if text is None or text == "":
        return False, "Input is empty."
    # Catches invalid UTF-8 byte sequences surfaced as lone surrogates by
    # Python's surrogateescape handling of argv/stdin.
    try:
        text.encode("utf-8", errors="strict")
    except UnicodeEncodeError:
        return False, "Input is not valid UTF-8 text."
    # Reject NUL bytes and other non-printable control bytes (binary-data
    # indicator), while allowing normal whitespace (newline/tab/CR).
    for ch in text:
        cp = ord(ch)
        if cp == 0 or (cp < 32 and ch not in ("\n", "\t", "\r")):
            return False, "Input contains invalid binary/control characters."
    if len(text) > CHAT_MAX_LENGTH:
        return False, f"Input exceeds maximum length of {CHAT_MAX_LENGTH} characters (got {len(text)})."
    return True, None


def _get_os_user_label():
    """Returns the current OS user, strictly as a [CLI ...] audit-log label
    (FR-006). This value is NEVER used in any authorization decision — the
    CLI channel's sole authorization boundary is an authenticated SSH
    session on the host (FR-009); CLIAdapter.is_authorized() always returns
    True regardless of this value."""
    try:
        return getpass.getuser()
    except Exception:
        return "unknown"


def _chat_turn(user_text, engine, adapter, tracer, os_user):
    """Runs one CLI chat turn: validate -> authorize -> gather context ->
    call the shared Gemini helper -> print -> persist. Shared by both the
    one-shot and REPL paths of cmd_chat(). Returns True on success."""
    ok, err = validate_chat_input(user_text)
    if not ok:
        print(f"Error: {err}", file=sys.stderr)
        return False

    # US2: genuinely exercise CLIAdapter end-to-end (process_message(), which
    # internally calls is_authorized()) as part of the live turn flow —
    # always authorized under the SSH-boundary model — rather than leaving
    # ChannelAdapter unused the way telegram_daemon.py's ad hoc whitelist
    # check does today.
    gate = adapter.process_message(os_user, CLI_SESSION_ID, user_text)
    if gate.get("status") != "success":
        print(f"Error: {gate.get('response', 'not authorized.')}", file=sys.stderr)
        return False
    normalized_text = gate.get("normalized_message", user_text)

    print(f"[CLI AUTH] user={os_user} channel=cli turn accepted", flush=True)

    try:
        history = engine.get_recent(session_id=CLI_SESSION_ID, limit=20)
    except Exception as e:
        print(f"[CLI WARNING] Failed to load conversation history: {e}", flush=True)
        history = []

    try:
        from telegram_daemon import query_gemini
        response = query_gemini(normalized_text, session_id=CLI_SESSION_ID, history=history)
    except Exception as e:
        print(f"Agent backend unreachable: {e}", file=sys.stderr)
        return False

    # query_gemini() swallows its own request/auth errors and returns them as
    # a normal string rather than raising — detect those cases here so they
    # surface as a clear "Agent backend unreachable" error (FR-005) instead
    # of being printed as if they were a real agent response.
    if response.startswith("Error: GEMINI_API_KEY") or response.startswith("Gemini API Error:"):
        print(f"Agent backend unreachable: {response}", file=sys.stderr)
        return False

    print(response)

    try:
        engine.add_memory(normalized_text, session_id=CLI_SESSION_ID, role="user")
        # Don't persist Gemini's degenerate "no response" placeholder as if it
        # were real agent content — it would otherwise get fed back as false
        # context on a later turn via get_recent().
        if response != "No response generated by Gemini.":
            engine.add_memory(response, session_id=CLI_SESSION_ID, role="agent")
    except Exception as e:
        print(f"[CLI WARNING] Failed to persist conversation turn: {e}", flush=True)

    span = tracer.create_span("cli.chat_turn", {"channel": "cli", "user": os_user})
    print(f"[CLI AUDIT] channel=cli user={os_user} trace_id={span['trace_id']} span_id={span['span_id']}", flush=True)

    return True


def cmd_chat(args):
    from vector_memory import VectorMemoryEngine
    from channel_gateway import CLIAdapter
    from otel_tracing import OTelTracer

    os_user = _get_os_user_label()
    engine = VectorMemoryEngine()
    adapter = CLIAdapter()
    tracer = OTelTracer()

    if args.message is not None:
        # One-shot: send one message, print the response, exit. Strip first so
        # a whitespace-only message is treated the same as the REPL path
        # (which strips-and-skips blank lines rather than sending a turn).
        stripped_message = args.message.strip()
        if not stripped_message:
            print("Error: Input is empty.", file=sys.stderr)
            sys.exit(1)
        ok = _chat_turn(stripped_message, engine, adapter, tracer, os_user)
        sys.exit(0 if ok else 1)

    # Interactive REPL. Exit via /exit, /quit, Ctrl-D (EOF), or Ctrl-C
    # (SIGINT) — all terminate cleanly with no orphaned processes or
    # corrupted session state (FR-004). No idle timeout (FR-004).
    print("OpenClaw CLI Chat (type /exit or Ctrl-D to quit)")
    while True:
        try:
            line = input("> ")
        except EOFError:
            print()
            print("[CLI] Exiting (EOF).", flush=True)
            break
        except KeyboardInterrupt:
            print()
            print("[CLI] Exiting (interrupted).", flush=True)
            break
        except UnicodeDecodeError:
            print("Error: input is not valid UTF-8 text.", file=sys.stderr)
            continue

        stripped = line.strip()
        if stripped in ("/exit", "/quit"):
            print("[CLI] Exiting.", flush=True)
            break
        if not stripped:
            continue

        try:
            _chat_turn(line, engine, adapter, tracer, os_user)
        except KeyboardInterrupt:
            print()
            print("[CLI] Exiting (interrupted).", flush=True)
            break


def cmd_channels(args):
    if args.subcommand == "status":
        print("⚡ OpenClaw Multi-Channel Transport Gateway Status")
        print("------------------------------------------------")
        print("  Telegram Adapter : ACTIVE (Long-Polling Egress)")
        allowed_ids = os.environ.get("TELEGRAM_ALLOWED_USER_IDS", "")
        print(f"  Whitelisted Users: {allowed_ids if allowed_ids else 'None set'}")
        
        if args.probe:
            print("\n🔍 Running Active Channel Probe...")
            token = os.environ.get("TELEGRAM_BOT_TOKEN", "")
            if token:
                try:
                    url = f"https://api.telegram.org/bot{token}/getMe"
                    req = urllib.request.Request(url)
                    with urllib.request.urlopen(req, timeout=5) as resp:
                        res = json.loads(resp.read().decode())
                        if res.get("ok"):
                            bot_info = res.get("result", {})
                            print(f"  [Telegram Probe OK] Bot Handle: @{bot_info.get('username')} (ID: {bot_info.get('id')})")
                        else:
                            print(f"  [Telegram Probe FAIL] Response: {res}")
                except Exception as e:
                    print(f"  [Telegram Probe ERROR] Unable to reach Telegram API: {e}")
            else:
                print("  [Telegram Probe SKIPPED] TELEGRAM_BOT_TOKEN environment variable not set.")
    else:
        print("Usage: openclaw channels status [--probe]")

def cmd_gateway(args):
    if args.subcommand == "status":
        print("⚡ OpenClaw Gateway Status")
        print("-------------------------")
        port = os.environ.get("OPENCLAW_CONTROL_PORT", "18789")
        try:
            url = f"http://127.0.0.1:{port}/api/status"
            with urllib.request.urlopen(url, timeout=3) as resp:
                data = json.loads(resp.read().decode())
                print(f"  Control UI Web Server : ONLINE (Port {port})")
                print(f"  Gateway Health        : {data.get('status', 'unknown')}")
                if args.deep:
                    print("\n🔍 Deep Gateway Inspection:")
                    for k, v in data.get("components", {}).items():
                        print(f"    - {k}: {v}")
        except Exception as e:
            print(f"  Control UI Web Server : OFFLINE or UNREACHABLE ({e})")
    else:
        print("Usage: openclaw gateway status [--deep]")

def cmd_models(args):
    if args.subcommand == "list":
        print("🧠 Available Gemini Models")
        print("--------------------------")
        print("  - gemini-2.5-flash (Default - Fast Reasoning & Multi-modal)")
        print("  - gemini-2.5-pro   (High Intelligence & Complex Logic)")
        print("  - gemini-1.5-flash (Legacy Lightweight)")
    else:
        print("Usage: openclaw models list")

def cmd_doctor(args):
    print("🩺 OpenClaw Diagnostic Check")
    print("----------------------------")
    # Check GCP Project / ADC
    project_id = os.environ.get("GCP_PROJECT_ID", "openclaw-tf-90326")
    print(f"  [+] GCP Project ID     : {project_id}")

    # Check secrets
    gemini_key = os.environ.get("GEMINI_API_KEY")
    tg_token = os.environ.get("TELEGRAM_BOT_TOKEN")
    print(f"  [{'✓' if gemini_key else '✗'}] Gemini API Key      : {'Configured' if gemini_key else 'Missing'}")
    print(f"  [{'✓' if tg_token else '✗'}] Telegram Bot Token  : {'Configured' if tg_token else 'Missing'}")

    # Check Persistent Storage
    data_dir = "/mnt/disks/openclaw-data"
    mounted = os.path.exists(data_dir)
    print(f"  [{'✓' if mounted else '✗'}] Persistent Disk Mount: {'Mounted at ' + data_dir if mounted else 'Not Mounted'}")
    print("\nSystem Health: ALL SYSTEMS OPERATIONAL")

def main():
    parser = argparse.ArgumentParser(prog="openclaw", description="OpenClaw CLI Management Tool")
    subparsers = parser.add_subparsers(dest="command")

    # Channels parser
    p_chan = subparsers.add_parser("channels", help="Manage and inspect channels")
    p_chan.add_argument("subcommand", choices=["status"], help="Channel action")
    p_chan.add_argument("--probe", action="store_true", help="Perform active network probe to transport APIs")

    # Gateway parser
    p_gate = subparsers.add_parser("gateway", help="Manage and inspect gateway")
    p_gate.add_argument("subcommand", choices=["status"], help="Gateway action")
    p_gate.add_argument("--deep", action="store_true", help="Perform deep gateway status inspection")

    # Models parser
    p_mod = subparsers.add_parser("models", help="Manage and list LLM models")
    p_mod.add_argument("subcommand", choices=["list"], help="Model action")

    # Doctor parser
    p_doc = subparsers.add_parser("doctor", help="Run system diagnostics")

    # Chat parser
    p_chat = subparsers.add_parser(
        "chat",
        help="Chat with the OpenClaw agent from the terminal (SSH session is the only authorization boundary)"
    )
    p_chat.add_argument(
        "message",
        nargs="?",
        default=None,
        help="One-shot message to send. Omit to open an interactive REPL (exit with /exit, /quit, Ctrl-D, or Ctrl-C)."
    )

    args = parser.parse_args()

    if args.command == "chat":
        cmd_chat(args)
    elif args.command == "channels":
        cmd_channels(args)
    elif args.command == "gateway":
        cmd_gateway(args)
    elif args.command == "models":
        cmd_models(args)
    elif args.command == "doctor":
        cmd_doctor(args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
